{
  "name": "alfred-text-to-calendar",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node scripts/process-text.js",
    "clean": "rm -rf node_modules",
    "build": "yarn install && zip -r text-to-calendar.alfredworkflow . -x '*.git*' '*.DS_Store' 'README.md' 'LICENSE' '.idea/*' '.husky/*'",
    "package": "yarn clean && yarn build",
    "prepare": "husky install"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "ical-generator": "^5.0.0",
    "openai": "^6.3.0",
    "tmp-promise": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "husky": "^8.0.3"
  },
  "packageManager": "yarn@4.9.1+sha512.f95ce356460e05be48d66401c1ae64ef84d163dd689964962c6888a9810865e39097a5e9de748876c2e0bf89b232d583c33982773e9903ae7a76257270986538"
}
